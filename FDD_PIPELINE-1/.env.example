# Unused by the pipeline. Settings live in the parent folder's .env.
# Pick one provider and set its key. LLM_PROVIDER defaults to "anthropic".
LLM_PROVIDER=bedrock

# AWS Bedrock (API key auth). Region must match the key.
# Use an inference profile ID (eu....), not the foundation model ID.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o

# GOOGLE_API_KEY=your-key-here
# GEMINI_MODEL=gemini-1.5-pro
