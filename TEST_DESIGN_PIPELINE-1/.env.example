# Pick one provider and set its key. LLM_PROVIDER defaults to "anthropic".
LLM_PROVIDER=bedrock

# AWS Bedrock (API key auth). Region must match the key.
# Use an inference profile ID (eu....), not the foundation model ID.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# The variable name above matters: langchain-aws reads
# AWS_BEARER_TOKEN_BEDROCK. A plain AWS_BEARER_TOKEN is ignored, and
# boto3 quietly falls through to ~/.aws instead.

# Throughput. Tier 3 fans out ten agents at once, which is what provokes
# ServiceUnavailableException from Bedrock; this caps calls in flight.
# Lower it to 1 to serialize while a region is struggling.
# LLM_MAX_CONCURRENCY=4

# Seconds without bytes on a streamed reply before it counts as a stall.
# LLM_READ_TIMEOUT=120
# LLM_MAX_OUTPUT_TOKENS=24000

# Tried after three transient failures in a row. Leave unset to stay on
# the primary for the whole retry budget.
# BEDROCK_FALLBACK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_FALLBACK_REGION=eu-west-1

# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o

# GOOGLE_API_KEY=your-key-here
# GEMINI_MODEL=gemini-1.5-pro

# Unused by the pipeline. Settings live in the parent folder's .env.
